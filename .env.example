# ---------------------------------------------------------------------------
# github-radar environment configuration.
# Copy this file to `.env` and fill in the required values:
#
#   cp .env.example .env
#
# Never commit `.env` — it may contain secrets.
# ---------------------------------------------------------------------------

# Deployment: local is the default; public requires a restricted read-only DB role.
# Public mode refuses all GitHub/AI/workspace credentials. See docs/PRODUCTION_READINESS.md.
DEPLOYMENT_MODE=local
# PUBLIC_ALLOWED_HOSTS='["radar.example.org"]'

# GitHub API token (classic: "public_repo" or "repo" scope is enough;
# fine-grained: "Public repositories" with "Metadata: Read").
# Unauthenticated anonymous access is possible but heavily rate-limited.
GITHUB_TOKEN=

# Explicit psycopg/libpq URL; local PostgreSQL also needs TLS and SCRAM passwords.
# Use a trusted CA and a hostname matching its server certificate. Never use a pooler.
# Update your private .env manually; the driver migration does not rewrite credentials.
DATABASE_URL=postgresql+psycopg://github_radar:CHANGE_ME@localhost:5432/github_radar?sslmode=verify-full&channel_binding=require&sslrootcert=/ABSOLUTE/PATH/ca.crt

# Prefer `uv run --frozen python -m tests.run_postgres`: creates NEW TLS/SCRAM
# PostgreSQL 16 clusters and overrides any operator database configuration.
# Advanced manual fixtures must be disposable: tests DROP their tables and revision.
# Never point TEST_DATABASE_URL at the existing application database.
# TEST_DATABASE_URL=postgresql+psycopg://test:CHANGE_ME@localhost:5432/github_radar_test?sslmode=verify-full&channel_binding=require&sslrootcert=/ABSOLUTE/PATH/test-ca.crt

# Private single-admin networking workspace. Empty means DISABLED.
# Generate a separate random token: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Also required for local HTTP AI generation; CLI AI remains explicit operator work.
# Never reuse GITHUB_TOKEN. Direct loopback only; public/reverse-proxy access is unsupported.
# See docs/NETWORKING_WORKSPACE.md before enabling. Keep .env readable only by the admin.
WORKSPACE_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown). All values may be overridden via env vars.
# ---------------------------------------------------------------------------

# GitHub API base URL (useful for proxies and testing).
# GITHUB_API_BASE_URL=https://api.github.com
# API version header sent on every request.
# GITHUB_API_VERSION=2022-11-28

# HTTP timeouts and retry behaviour.
# HTTP_TIMEOUT_SECONDS=15
# HTTP_MAX_RETRIES=3

# When remaining quota for a rate-limit resource drops at or below this,
# the client refuses further requests instead of hammering the API.
# RATE_LIMIT_PAUSE_THRESHOLD=50
# Search has a smaller independent quota.
# SEARCH_RATE_LIMIT_PAUSE_THRESHOLD=2

# Hard HTTP-attempt caps per GitHub client/run; retries and pagination count.
# Zero disables a scope. JSON keys omitted here retain their defaults.
# GITHUB_REQUEST_BUDGET='{"total":100,"search":10,"repository_details":30,"contributors":30,"profiles":30}'

# Discovery safety caps (a --limit above DISCOVER_MAX_LIMIT is rejected).
# DISCOVER_DEFAULT_LIMIT=25
# DISCOVER_MAX_LIMIT=500
# SEARCH_PER_PAGE=100

# Legacy service default / discover cost-preview limit, not automatic enrichment.
# The explicit enrich command uses --contributors-limit (default 10).
# CONTRIBUTORS_LIMIT_PER_REPO=30

# Re-fetch developer profiles and completed contributor batches at this age.
# PROFILE_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# AI synthesis layer (github-radar ai ...).
# All of these are optional: deterministic analytics never require them. AI
# commands fail clearly until AI_API_KEY and AI_MODEL are configured.
# ---------------------------------------------------------------------------

# API key for an OpenAI-compatible chat-completions provider.
# AI_API_KEY=

# Base URL of the OpenAI-compatible API (works with OpenRouter & others).
# AI_BASE_URL=https://api.openai.com/v1

# Model name, e.g. gpt-4o-mini or a hosted model id.
# AI_MODEL=

# Per-request timeout and max output tokens for the synthesis calls.
# AI_TIMEOUT_SECONDS=60
# AI_MAX_OUTPUT_TOKENS=2048

# Sampling temperature for the (single, conservative) synthesis call.
# AI_TEMPERATURE=0.2

# Hard cap on model requests made by one github-radar run.
# AI_MAX_REQUESTS_PER_RUN=20

# Hard cap on the total characters of textual evidence sent per prompt.
# AI_MAX_EVIDENCE_CHARS=12000

# Root log level.
# LOG_LEVEL=INFO
