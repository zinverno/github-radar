# ---------------------------------------------------------------------------
# github-radar environment configuration.
# Copy this file to `.env` and fill in the required values:
#
#   cp .env.example .env
#
# Never commit `.env` — it may contain secrets.
# ---------------------------------------------------------------------------

# GitHub API token (classic: "public_repo" or "repo" scope is enough;
# fine-grained: "Public repositories" with "Metadata: Read").
# Unauthenticated anonymous access is possible but heavily rate-limited.
GITHUB_TOKEN=

# PostgreSQL connection string used by the application (asyncpg driver).
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://github_radar:CHANGE_ME@localhost:5432/github_radar

# Separate database for the destructive PostgreSQL integration tests.
# Must NOT point at the application database: integration fixtures drop tables
# and the alembic_version bookkeeping table. The test suite refuses to run if
# TEST_DATABASE_URL is unset, equals DATABASE_URL, names 'github_radar', or
# does not look like a test database (e.g. github_radar_test / *_test / test_*).
TEST_DATABASE_URL=postgresql+asyncpg://github_radar:CHANGE_ME@localhost:5432/github_radar_test

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown). All values may be overridden via env vars.
# ---------------------------------------------------------------------------

# GitHub API base URL (useful for proxies and testing).
# GITHUB_API_BASE_URL=https://api.github.com
# API version header sent on every request.
# GITHUB_API_VERSION=2022-11-28

# HTTP timeouts and retry behaviour.
# HTTP_TIMEOUT_SECONDS=15
# HTTP_MAX_RETRIES=3

# When remaining quota for a rate-limit resource drops at or below this,
# the client refuses further requests instead of hammering the API.
# RATE_LIMIT_PAUSE_THRESHOLD=50

# Discovery safety caps (a --limit above DISCOVER_MAX_LIMIT is rejected).
# DISCOVER_DEFAULT_LIMIT=25
# DISCOVER_MAX_LIMIT=500

# Maximum contributor rows fetched per repository.
# CONTRIBUTORS_LIMIT_PER_REPO=30

# Re-fetch a developer's public profile only if it is at least this old.
# PROFILE_REFRESH_DAYS=7

# Root log level.
# LOG_LEVEL=INFO